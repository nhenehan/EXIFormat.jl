#!/usr/bin/env bash
# The exiformat command line: runs EXIFormat.CLI.main in this repository's environment.
# Env: EXIFORMAT_JULIA  the julia to run (default: julia on PATH)
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec "${EXIFORMAT_JULIA:-julia}" --startup-file=no --history-file=no --project="$ROOT" \
    -e 'using EXIFormat; exit(EXIFormat.CLI.main(ARGS))' -- "$@"
